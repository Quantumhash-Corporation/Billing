# ---- MySQL ----
DB_HOST=
DB_PORT=3306
DB_NAME=Billing
DB_USER=
# Quote the password if it contains # or $
DB_PASSWORD=''

# ---- Dashboard ----
SERVER_PORT=4600
SYNC_INTERVAL_MINUTES=60
# Set to 1 when the dashboard is served over https (sets Secure cookies)
COOKIE_SECURE=0
# Password for the dashboard login screen
DASHBOARD_PASSWORD=
# Long random string used to sign the login cookie
SESSION_SECRET=

# ---- Provider keys (leave empty until you have them) ----
# OpenAI: an ADMIN key (sk-admin-...) from platform.openai.com > Settings > Organization > Admin keys
OPENAI_ADMIN_KEY=
# Mistral, one of the two:
#  - an Admin API key from backoffice.mistral.ai (a normal API key is refused), or
#  - your login session: sign in at admin.mistral.ai, open DevTools > Application > Cookies,
#    and copy the ory_session_... cookie as name=value. Wrap it in single quotes.
MISTRAL_ADMIN_KEY=
MISTRAL_SESSION_COOKIE=
# Optional, email + password accounts only: lets the dashboard sign in to Mistral again by
# itself when the session expires (and powers the "Refresh login" button on the card).
MISTRAL_EMAIL=
MISTRAL_PASSWORD=''
# AssemblyAI: normal API key
ASSEMBLYAI_API_KEY=
# Recall.ai: API key + the region your workspace lives in
RECALL_API_KEY=
# one of: us-east-1, us-west-2, eu-central-1, ap-northeast-1
RECALL_REGION=us-west-2
# Ollama Cloud: API key from ollama.com/settings/keys
OLLAMA_API_KEY=
# MailBaby: API key from the Mail.Baby panel
MAILBABY_API_KEY=
